<%- include("partials/header") %>
    <%- include("partials/navigation") %>

        <main class="page-main">
            <section class="page-introduction">
                <p class="section-label">Explore TerraQuest</p>

                <h1>Wildlife habitats</h1>

                <p>
                    Journey through immersive environments inspired by some of
                    the world’s most important ecosystems.
                </p>
            </section>

            <section class="habitat-grid" aria-label="TerraQuest habitats">
                <% habitats.forEach((habitat, index)=> { %>
                    <article class="habitat-card <%= index === habitats.length - 1 ? 'habitat-card-featured' : '' %>">
                        <img class="habitat-card-image" src="/images/<%= habitat.slug %>.png"
                            alt="<%= habitat.name %> wildlife habitat">

                        <div class="habitat-card-overlay"></div>

                        <div class="habitat-card-content">
                            <% if (index===habitats.length - 1) { %>
                                <p class="habitat-card-label">
                                    Family experience
                                </p>
                                <% } %>

                                    <h2>
                                        <%= habitat.name %>
                                    </h2>

                                    <p>
                                        <%= habitat.short_description %>
                                    </p>

                                    <a class="habitat-card-link" href="/habitats/<%= habitat.slug %>">
                                        Explore this habitat
                                    </a>
                        </div>
                    </article>
                    <% }) %>
            </section>
        </main>

        <%- include("partials/footer") %>
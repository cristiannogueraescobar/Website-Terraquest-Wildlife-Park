<%- include("partials/header") %>
    <%- include("partials/navigation") %>

        <main class="habitat-detail-main">
            <section class="habitat-detail-hero" style="background-image:
            linear-gradient(
                90deg,
                rgba(8, 32, 24, 0.92),
                rgba(8, 32, 24, 0.58),
                rgba(8, 32, 24, 0.18)
            ),
            url('/images/<%= habitat.slug %>.png');">
                <div class="habitat-detail-hero-content">
                    <p class="section-label">TerraQuest habitat</p>

                    <h1>
                        <%= habitat.name %>
                    </h1>

                    <p class="habitat-description">
                        <%= habitat.full_description %>
                    </p>

                    <a class="habitat-back-link" href="/habitats">
                        ← Back to all habitats
                    </a>
                </div>
            </section>

            <section class="experiences-section habitat-experiences" aria-labelledby="experiences-heading">
                <div class="section-heading">
                    <p class="section-label">Explore and discover</p>

                    <h2 id="experiences-heading">
                        Experiences in this habitat
                    </h2>
                </div>

                <div class="experience-grid">
                    <% experiences.forEach((experience)=> { %>
                        <article class="experience-card">
                            <p class="experience-type">
                                <%= experience.experience_type %>
                            </p>

                            <h3>
                                <%= experience.name %>
                            </h3>

                            <p>
                                <%= experience.short_description %>
                            </p>
                        </article>
                        <% }) %>
                </div>
            </section>
        </main>

        <%- include("partials/footer") %>
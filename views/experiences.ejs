<%- include("partials/header") %>
    <%- include("partials/navigation") %>

        <main class="page-main">
            <section class="page-introduction">
                <p class="section-label">Explore and learn</p>

                <h1>Park experiences</h1>

                <p>
                    Discover wildlife exhibits, educational talks, adventure trails
                    and supervised family activities across TerraQuest.
                </p>
            </section>

            <section class="experience-filters" aria-labelledby="experience-filter-heading">
                <h2 id="experience-filter-heading">Filter experiences</h2>

                <div class="filter-controls">
                    <div class="filter-group">
                        <label for="experience-habitat">Habitat</label>

                        <select id="experience-habitat">
                            <option value="">All habitats</option>

                            <% habitats.forEach((habitat)=> { %>
                                <option value="<%= habitat.slug %>">
                                    <%= habitat.name %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="filter-group">
                        <label for="experience-type">Experience type</label>

                        <select id="experience-type">
                            <option value="">All experience types</option>

                            <% experienceTypes.forEach((type)=> { %>
                                <option value="<%= type.experience_type %>">
                                    <%= type.experience_type %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                </div>
            </section>

            <p id="experiences-status" class="events-status" role="status" aria-live="polite"></p>

            <section id="experiences-grid" class="all-experiences-grid" aria-label="TerraQuest visitor experiences">
            </section>
        </main>

        <script src="/js/experiences.js" defer></script>

        <%- include("partials/footer") %>